#include "stdio.h"

int v[] intercala(int v[], int a, int m, int b){
  int u []; 
  int i, j;
  if (a>=b)
    return v;
  i = a;
  j = m+1;
  for (int k = 0; k <= b-a; k++){
    if ((j>b) || ((i <= m) && (v[i) <= v[j]))
    {
      u[k] = v[i];
      i = i +1;
    }else{
      u[k] = v[j];
      j = j+1;
    }
  }
  for (int l = a; l < b; l++)//verificar
    v[l] = u[l];
  return v;
}

int v[] mergeSort(int v[], int a, int b){
  int m;
  if (a>=b)
    return v;
  m = ((a +b)/2) -1;//piso 
  mergeSort(v, a, m);
  mergeSort(v, m+1, b);
  return intercala(v, a, m, b);
}
