#include <stdio.h>

int posR (int t[], int n, int r)
{

if (r = n+1){
  imprime_solução()
  return;
}

for (int j = 1; j<=n; j++){
  int legal = 1;

  for(int i = 1; i < r-1; i++){
    if (t[i] = j || t[i] = j+r-i || t[i] = j-r+i)
      legal = 0;
  }

  if (legal)
  {
    t[r] = j;
    posR(t,n,r+1)
  }
}

return;
}
